{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-delimiter": "error",
    "element-name": "error",
    "no-trailing-whitespace": "error",
    "no-inline-style": "off",
    "no-implicit-button-type": "error",
    "no-dup-id": "error",
    "void-style": "off",
    "doctype-style": "off"
  }
}
