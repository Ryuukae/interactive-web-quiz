{
  "name": "interactive-web-quiz",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise-grade interactive quiz platform featuring visual card creation, dual QAD/JSON data ingestion, auto-expanding textareas, and automated unit testing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.js --max-warnings 0",
    "lint:fix": "eslint src/**/*.js --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "lint:spell": "cspell \"src/**/*.{js,css,html}\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^8.19.4",
    "eslint": "^8.57.0",
    "eslint-plugin-jsdoc": "^61.7.1",
    "html-validate": "^10.9.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
