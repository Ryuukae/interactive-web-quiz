{
  "name": "interactive-web-quiz",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Enterprise-grade interactive quiz platform featuring visual card creation, dual QAD/JSON data ingestion, auto-expanding textareas, and automated unit testing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "npx rimraf dist coverage .eslintcache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:spell && npm run lint:secrets && npm run lint:versions",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint src/**/*.js --max-warnings 0",
    "lint:js:fix": "eslint src/**/*.js --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:html": "html-validate \"*.html\"",
    "lint:spell": "cspell \"src/**/*.{js,css,html}\" \"*.html\"",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:versions": "node scripts/verify-versions.js",
    "lint:commit": "commitlint --edit",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.html\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.html\"",
    "size": "size-limit",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "audit": "npm audit --audit-level=high",
    "deps:check": "npm outdated",
    "prepare": "husky",
    "verify": "npm run format:check && npm run lint && npm run size && npm run typecheck && npm run test:coverage && npm run audit && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^8.19.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "globals": "^17.10.0",
    "html-validate": "^10.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.3",
    "secretlint": "^13.0.4",
    "size-limit": "^13.0.3",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^5.1.16"
  }
}
