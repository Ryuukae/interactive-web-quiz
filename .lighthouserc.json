{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.9 },
          "error",
          { "minScore": 0.85 }
        ],
        "categories:accessibility": [
          "warn",
          { "minScore": 0.9 },
          "error",
          { "minScore": 0.85 }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.9 },
          "error",
          { "minScore": 0.85 }
        ],
        "categories:seo": [
          "warn",
          { "minScore": 0.9 },
          "error",
          { "minScore": 0.85 }
        ],
        "categories:pwa": [
          "warn",
          { "minScore": 0.9 },
          "error",
          { "minScore": 0.85 }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
