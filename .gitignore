# Ignore all by default
*

# Only allow certain Folders
!public/
!src/
!src/css/
!src/js/
!src/js/components/
!src/js/controllers/
!src/js/models/
!src/js/utils/
!tests/
!tests/unit/
!tests/integration/
!tests/e2e/
!.github/
!.github/workflows/
!.husky/


# Only allow certain files
!.gitignore
!.gitattributes
!.github/PULL_REQUEST_TEMPLATE.md
!CHANGELOG.md
!package.json
!package-lock.json
!jsconfig.json
!.eslintrc.json
!.htmlvalidate.json
!.prettierrc
!vite.config.js
!playwright.config.js
!.commitlintrc.json
!.stylelintrc.json
!.secretlintrc.json
!.size-limit.json
!.lighthouserc.json
!.lintstagedrc.json
!.husky/pre-commit
!.husky/pre-push
!.husky/commit-msg
!.cspell.json
!eslint.config.js

# .HTML
!index.html

# .JSON
!public/*.json

# .TXT
!public/*.txt

# .YML
!.github/dependabot.yml
!.github/labeler.yml
!.github/workflows/*.yml

# GitHub Config
!.github/CODEOWNERS

# .CSS
!src/css/*.css

# .JS
!src/js/*.js
!src/js/components/*.js
!src/js/controllers/*.js
!src/js/models/*.js
!src/js/utils/*.js
!tests/unit/*.js
!tests/integration/*.js

# .SPEC.JS
!tests/e2e/*.spec.js

