# Ignore all by default
*

# Only allow certain Folders
!public/
!src/
!src/css/
!src/js/
!src/js/components/
!src/js/controllers/
!src/js/models/
!src/js/utils/
!tests/
!tests/unit/
!tests/integration/
!.github/
!.github/workflows/

# Only allow certain files
!.gitignore
!package.json
!package-lock.json
!jsconfig.json
!.eslintrc.json
!.prettierrc

# HTML
!index.html

# JSON
!*.json
!public/*.json

# TXT
!public/*.txt

#YML
!.github/workflows/*.yml

# CSS
!src/css/*.css

# JS
!src/js/*.js
!src/js/components/*.js
!src/js/controllers/*.js
!src/js/models/*.js
!src/js/utils/*.js
!tests/unit/*.js
!tests/integration/*.js


