# Ignore all by default
*

# Only allow certain Folders
!public/
!src/
!src/css/
!src/js/
!src/js/components/
!src/js/controllers/
!src/js/models/
!src/js/utils/
!tests/
!tests/unit/
!tests/integration/
!tests/e2e/
!.github/
!.github/workflows/
!.husky/


# Only allow certain files
!.gitignore
!package.json
!package-lock.json
!jsconfig.json
!.eslintrc.json
!.htmlvalidate.json
!.prettierrc
!vite.config.js
!.commitlintrc.json
!.stylelintrc.json
!.secretlintrc.json
!.lighthouserc.json
!.lintstagedrc.json
!.husky/pre-commit
!.husky/pre-push
!.husky/commit-msg
!.cspell.json

# .HTML
!index.html

# .JSON
!public/*.json

# .TXT
!public/*.txt

# .YML
!.github/workflows/*.yml

# .CSS
!src/css/*.css

# .JS
!src/js/*.js
!src/js/components/*.js
!src/js/controllers/*.js
!src/js/models/*.js
!src/js/utils/*.js
!tests/unit/*.js
!tests/integration/*.js

# .SPEC.JS
!tests/e2e/*.spec.js

