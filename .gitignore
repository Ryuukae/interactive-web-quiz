# Ignore all by default
*

# Only allow certain Folders
!public/
!src/
!src/css/
!src/js/
!src/js/components/
!src/js/controllers/
!src/js/models/
!src/js/utils/

# Only allow certain files
!.gitignore
!package.json
!package-lock.json

# HTML
!index.html

# JSON
!public/*.json

# TXT
!public/*.txt

# CSS
!src/css/*.css

# JS
!src/js/*.js
!src/js/components/*.js
!src/js/controllers/*.js
!src/js/models/*.js
!src/js/utils/*.js


